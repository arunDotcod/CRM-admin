# Dotcod Admin (CRM-admin). Copy to .env.local for local overrides; Next loads it automatically.

# Nest API origin used by the /api/v1/admin rewrite in next.config.js (no path suffix).
# Default: http://127.0.0.1:4100. With `npm run dev:api` (local admin-enabled API) use :4150.
API_PROXY_TARGET=http://127.0.0.1:4150
# Demo deployment (nginx serves the API under /rest):
# API_PROXY_TARGET=https://demo-admin.dotcod.in/rest

# Browser API origin. Inlined into the client bundle at build time.
# Leave unset so the browser calls same-origin /api/v1/admin (the rewrite above). The staff refresh
# cookie is SameSite=Strict with Path=ADMIN_COOKIE_PATH, so it only works same-site.
# NEXT_PUBLIC_API_ORIGIN=https://demo-admin.dotcod.in/rest

# Optional build folder instead of .next (build while `npm run dev` is running).
# NEXT_DIST_DIR=.next-build

# --- Backend side (CRM-backend-server/.env), for reference -------------------------------------
# ADMIN_PORTAL_ORIGIN=http://127.0.0.1:8090    # must equal this app's origin exactly
# ADMIN_JWT_SECRET=<32+ chars, not AUTH_JWT_SECRET>
# ADMIN_COOKIE_PATH=/api/v1/admin/auth          # add the proxy prefix if the API is under /rest
# CHANNEL_SECRET_KEYS / CHANNEL_SECRET_ACTIVE_KID  # TOTP secrets are encrypted with this keyring
# `npm run dev:api` sets ADMIN_JWT_SECRET and the keyring from .local/admin-api.env (generated).

# --- Local test staff account --------------------------------------------------------------------
# A SUPER_ADMIN test account for local development is recorded in .local/test-staff.md
# (gitignored: email, password and TOTP key). Create your own with:
#   cd ../CRM-backend-server && yarn admin:create-staff <email> "<name>"
# (run with ADMIN_PORTAL_ORIGIN set, and DATABASE_URL pointed at the platform role; see README).
